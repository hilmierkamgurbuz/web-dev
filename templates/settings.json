{
  "_comment": "web-dev — project hook registration. Settings hooks run in every session and inside every subagent; skill-frontmatter hooks would only run while the skill is active, so enforcement lives here. Verify with /hooks after install; project hooks need the workspace trust dialog accepted once.",
  "_form": "Every hook uses exec form (command + args) so a project path containing spaces is never re-tokenized by a shell. One dispatcher script routes by event and tool name, so each tool call spawns one process.",
  "_no_if_on_the_gate": "The PreToolUse group carries no `if` filter. A filter that silently stops matching after a version change would turn the gate into a no-op.",
  "_deny": "EnterPlanMode is removed because web-dev plans through the approved brief. Worktree-isolated agents are refused because a fresh worktree moves CLAUDE_PROJECT_DIR away from the manifest paths the gate checks.",
  "permissions": {
    "deny": ["EnterPlanMode", "Agent(isolation:worktree)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "session-start"],
            "statusMessage": "web-dev: map health"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "prompt-submit"],
            "statusMessage": "web-dev: task state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "pre-tool"],
            "statusMessage": "web-dev: gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "post-tool"],
            "statusMessage": "web-dev: maps"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "subagent-start"],
            "statusMessage": "web-dev: map contract"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "web-dev-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "subagent-stop"],
            "statusMessage": "web-dev: recording review verdict"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/web-dev/hook.mjs", "stop"],
            "timeout": 1200,
            "statusMessage": "web-dev: turn audit"
          }
        ]
      }
    ]
  }
}
